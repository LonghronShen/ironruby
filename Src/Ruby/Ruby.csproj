<Project Sdk="MSBuild.Sdk.Extras">
	<PropertyGroup>
		<TargetFrameworks>net7;net8;net9;netstandard2.0;net35;net40</TargetFrameworks>

		<RootNamespace>IronRuby</RootNamespace>
		<AssemblyName>IronRuby</AssemblyName>

		<PackageId>IronRuby.Portable</PackageId>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>

	<PropertyGroup>
		<NoWarn>NU5128</NoWarn>
	</PropertyGroup>

	<ItemGroup Condition=" '$(TargetFramework)' == 'sl5' or '$(TargetFramework)' == 'net35' or '$(TargetFramework)' == 'net40' ">
		<PackageReference Include="DynamicLanguageRuntime.Legacy" Version="1.1.0.30" />
	</ItemGroup>

	<ItemGroup Condition=" '$(TargetFramework)' == 'netstandard2.0' or '$(TargetFramework)' == 'net7' or '$(TargetFramework)' == 'net8' or '$(TargetFramework)' == 'net9' ">
		<PackageReference Include="DynamicLanguageRuntime" Version="1.3.4" />
		<PackageReference Include="System.Diagnostics.TraceSource" Version="4.3.0" />
		<PackageReference Include="System.Runtime.Numerics" Version="4.3.0" />
		<PackageReference Include="System.Security.Permissions" Version="4.7.0" />
		<!--<PackageReference Include="YantraJS.ExpressionCompiler" Version="1.2.206" />-->
	</ItemGroup>

	<!--<Import Project="../../Build/profile336.props" />-->
	<Import Project="../../Build/sl5.props" Condition=" '$(TargetFramework)' == 'sl5' " />
	<Import Project="../../Build/net35.props" Condition=" '$(TargetFramework)' == 'net35' " />
	<Import Project="../../Build/net40.props" Condition=" '$(TargetFramework)' == 'net40' " />
	<Import Project="../../Build/netstandard2.0.props" Condition=" '$(TargetFramework)' == 'netstandard2.0' " />
	<Import Project="../../Build/net7.props" Condition=" '$(TargetFramework)' == 'net7' " />
	<Import Project="../../Build/net8.props" Condition=" '$(TargetFramework)' == 'net8' " />
	<Import Project="../../Build/net9.props" Condition=" '$(TargetFramework)' == 'net9' " />
</Project>